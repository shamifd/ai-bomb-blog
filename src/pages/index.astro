---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import IconRss from "@/assets/icons/IconRss.svg";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Socials from "@/components/Socials.astro";
import Card from "@/components/Card.astro";
import LinkButton from "@/components/LinkButton.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { slugifyStr } from "@/utils/slugify";
import { SECTIONS, WORKFLOW_TAG } from "@/data/sections";
import { useTranslations } from "@/i18n";
import config from "@/config";

const { posts: postsConfig } = config;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const posts = await getCollection("posts");
const sortedPosts = getSortedPosts(posts);
const workflowPosts = sortedPosts.filter(({ data }) =>
  data.tags.includes(WORKFLOW_TAG)
);
const recentPosts = sortedPosts.filter(
  ({ data }) => !data.tags.includes(WORKFLOW_TAG)
);
const sectionCards = SECTIONS.map(sec => {
  const list = sortedPosts.filter(({ data }) => data.tags.includes(sec.name));
  const singleToolPosts = list.filter(({ data }) => !data.tags.includes(WORKFLOW_TAG));
  return {
    ...sec,
    href: getRelativeLocaleUrl(locale, `tags/${slugifyStr(sec.name)}/`),
    count: list.length,
    tools: [
      ...new Set(singleToolPosts.map(({ data }) => data.tool).filter(Boolean)),
    ],
  };
});
const homePath = getRelativeLocaleUrl(locale, "");

const siteData = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": `${config.site.url}#website`,
      name: config.site.title,
      url: config.site.url,
      description: config.site.description,
      inLanguage: config.site.lang,
      publisher: { "@id": `${config.site.url}#org` },
    },
    {
      "@type": "Organization",
      "@id": `${config.site.url}#org`,
      name: config.site.title,
      url: config.site.url,
      logo: new URL("logo-512.png", config.site.url).href,
      email: "shamifd@gmail.com",
    },
  ],
}).replace(/</g, "\\u003c");
---

<Layout>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={siteData} />
  </Fragment>
  <Header />
  <main
    id="main-content"
    data-layout="index"
    data-home-path={homePath}
    class="app-layout my-1"
  >
    <section id="hero" class="pt-10 pb-8">
      <p class="text-muted-foreground text-sm font-medium tracking-wide">
        ai_bomb Lab · 出海 AI 工具拆解
      </p>
      <h1 class="mt-3 text-3xl leading-tight font-bold tracking-tight sm:text-4xl">
        出海与高效率 AI 工作流拆解
      </h1>
      <p class="mt-4 leading-relaxed">
        持续追踪全球前沿 AI SaaS 与跨境出海工具，聚焦真实商业场景下的工作流拆解、<mark class="bg-brand text-brand-foreground rounded-sm px-0.5 whitespace-nowrap">成本算账</mark>与<mark class="bg-brand text-brand-foreground rounded-sm px-0.5 whitespace-nowrap">适用场景</mark>。
      </p>
      <p class="text-muted-foreground mt-3 text-sm leading-relaxed">
        同步更新：微信公众号 <strong class="text-foreground">bomb_ai</strong> · 知乎 <strong class="text-foreground">aibomb</strong> · 小红书 <strong class="text-foreground">ai_bomb</strong>
      </p>
    </section>

    <section id="sections" aria-labelledby="sections-title" class="pb-4">
      <h2 id="sections-title" class="text-xl font-semibold">按业务环节找工具</h2>
      <ul class="mt-4 grid grid-cols-1 gap-3 sm:grid-cols-2">
        {
          sectionCards.map(sec => (
            <li>
              <a
                href={sec.href}
                class="group border-border bg-background flex h-full flex-col rounded-xl border px-4 py-3 transition-[border-color,transform] duration-150 hover:border-foreground/60 hover:-translate-y-0.5"
              >
                <span class="flex items-baseline justify-between gap-2">
                  <span class="decoration-brand text-lg font-semibold decoration-[3px] underline-offset-4 group-hover:underline">
                    {sec.name}
                  </span>
                  <span class="text-muted-foreground text-sm">{sec.count} 篇</span>
                </span>
                <span class="text-muted-foreground mt-1 text-sm">{sec.blurb}</span>
                {sec.tools.length > 0 && (
                  <span class="mt-2 text-sm font-medium">{sec.tools.join(" · ")}</span>
                )}
              </a>
            </li>
          ))
        }
        <li>
          <a
            href={getRelativeLocaleUrl(locale, "stack")}
            class="bg-foreground text-background flex h-full flex-col justify-center rounded-xl px-4 py-3 transition-transform duration-150 hover:-translate-y-0.5"
          >
            <span class="text-lg font-semibold">
              AI 武器库 <span class="text-brand">→</span>
            </span>
            <span class="mt-1 text-sm opacity-80">全部工具一张表：痛点、适合谁、免费额度、价格</span>
          </a>
        </li>
      </ul>
    </section>

    {
      workflowPosts.length > 0 && (
        <section id="workflow" class="pt-10 pb-2">
          <h2 class="text-xl font-semibold">工作流串联</h2>
          <p class="text-muted-foreground mt-1 text-sm">把几款工具接成一条完整业务流程，从获客到成交。</p>
          <ul class="[&_a]:border-s-brand [&_a]:border-s-4">
            {workflowPosts.map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
        </section>
      )
    }

    {
      recentPosts.length > 0 && (
        <section id="recent-posts" class="pt-10 pb-2">
          <h2 class="text-xl font-semibold">{t.home.recentPosts}</h2>
          <ul>
            {recentPosts.slice(0, postsConfig.perIndex).map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
        </section>
      )
    }

    <div class="my-8 text-center font-medium">
      <LinkButton href={getRelativeLocaleUrl(locale, "posts")}>
        {t.home.allPosts}
        <IconArrowRight class="inline-block rtl:-rotate-180" />
      </LinkButton>
    </div>
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset;
    const baseRoot = import.meta.env.BASE_URL.replace(/\/?$/, "/");
    if (indexLayout?.layout) {
      sessionStorage.setItem("backUrl", indexLayout.homePath ?? baseRoot);
    }
  });
</script>
